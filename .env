# Meme-Vault Environment Configuration
# Generated for local development/testing

# The location where your uploaded files are stored
UPLOAD_LOCATION=/mnt/blomp/memes

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# Timezone
TZ=America/New_York

# The Immich version to use. Pin to a specific version like "v3.3.6" or use "release" for latest
IMMICH_VERSION=v3.4.2

# Connection secret for postgres. Change this to a secure random password!
DB_PASSWORD=RAicgZEn9jOH6NfKfj1x7dBchFB64WsZ

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=memevault

# Optional: Enable telemetry/metrics
# IMMICH_TELEMETRY_INCLUDE=all

# Machine Learning service URL (must match docker compose service name)
IMMICH_MACHINE_LEARNING_URL=http://meme-vault-machine-learning:3003
